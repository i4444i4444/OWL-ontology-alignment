# rdfs:comment overlay for data/wab_tractatus_subgraph.ttl.
# Contains ONLY the additional rdfs:comment triples; the base file is not
# modified.
# Comment sources (verified, no invented text):
#   - Date / Person / TextSubGenre: verbatim rdfs:comment texts from the
#     published WAB ontology
#     (https://wab.uib.no/cost-a32_philospace/wittgenstein.owl);
#   - remaining terms: derived from the WAB ontology axioms, prefixed with
#     "Derived from the WAB ontology axioms (the ontology publishes no
#     prose description for this term)".
# Usage: parse wab_tractatus_subgraph.ttl and this file into the same
# rdflib Graph.

@prefix ns1: <http://purl.org/wittgensteinsource/ont/scholar/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wab: <http://purl.org/wittgensteinsource/ont/> .

wab:Part rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). WAB's own comment carries only the term name. By its axioms, Part is a subclass of WittgensteinSource; together with Bemerkung it forms the range of hasPart and isPublishedInWork, and the domain of isPartOf and isWorkPublishedFrom."@en .

wab:contains rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: WittgensteinSource. Range: scholar:TextSubGenre. owl:inverseOf: isContainedIn."@en .

wab:hasPart rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: WittgensteinSource. Range: union of Bemerkung and Part. owl:inverseOf: isPartOf."@en .

wab:isDateOf rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: scholar:Date. Range: Bemerkung. owl:inverseOf: hasDate."@en .

wab:isPartOf rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: union of Bemerkung and Part. Range: WittgensteinSource. owl:inverseOf: hasPart."@en .

wab:isPublishedInWork rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: Bemerkung. Range: union of Werk and Part. owl:inverseOf: isWorkPublishedFrom."@en .

wab:isReferredToIn rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: union of scholar:Person, WittgensteinExternalSource, Bemerkung and Werk. Range: union of WittgensteinSource and scholar:SecondarySource. owl:inverseOf: refersTo."@en .

wab:isWorkPublishedFrom rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: union of Werk and Part. Range: Bemerkung. owl:inverseOf: isPublishedInWork."@en .

wab:language rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: scholar:Source. Range: scholar:Language."@en .

wab:madeAfter rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: scholar:Source. Range: xsd:date. Publication/creation date in a chronological constraint pair with madeBefore."@en .

wab:madeBefore rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: scholar:Source. Range: xsd:date. WAB labels the sibling property \"made after\"; together they bound the estimated date of a source."@en .

wab:refersTo rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: union of WittgensteinSource and scholar:SecondarySource. Range: union of scholar:Person, Bemerkung, Werk and WittgensteinExternalSource. owl:inverseOf: isReferredToIn."@en .

ns1:Date rdfs:comment "Date, subclass of Subject: A date, either day-exact or estimated date span. Example of instance: 19361105; 19450101-19451231" .

ns1:Language rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). WAB's own comment is absent. By its axioms, Language is a subclass of scholar:Subject and is the range of the language property (domain scholar:Source)."@en .

ns1:Person rdfs:comment "Person: A historical person. Example of instance: Plato; Paul Wittgenstein" .

ns1:TextSubGenre rdfs:comment "The text subgenre of a source or part of source. Example of instance: logical notation; secret code" .

ns1:hasAuthor rdfs:comment "Derived from the WAB ontology axioms (the ontology publishes no prose description for this term). Domain: union of scholar:SecondarySource, Bemerkung, WittgensteinExternalSource and Werk. Range: scholar:Person. owl:inverseOf: isAuthoredBy is not declared."@en .

